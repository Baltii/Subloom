{
  "manifest_version": 3,
  "name": "Subloom",
  "description": "See your next renewal and what's due this week in Subloom.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Subloom renewals",
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://app.subloom.tn/*"],
  "content_scripts": [
    {
      "matches": ["https://app.subloom.tn/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
