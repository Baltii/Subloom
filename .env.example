# Public mobile configuration. Never put server secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
# false: all available features are free; true: enforce existing Free/Pro rules.
# Run npm run configure:plans after changing this, then rebuild/reload the app.
EXPO_PUBLIC_PRO_PLAN_ENABLED=false
# Public P-256 verification key generated by scripts/generate-pro-key.mjs.
EXPO_PUBLIC_PRO_LICENSE_PUBLIC_KEY=
# Only for direct/sideloaded native builds with an appropriate payment policy.
# App Store / Google Play releases need their own in-app purchase integration.
EXPO_PUBLIC_ALLOW_NATIVE_STRIPE_CHECKOUT=false
# Set these ONLY with `supabase secrets set`, never in the mobile build:
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_DELIVERY_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=Subloom <reminders@your-verified-domain.com>
# For temporary testing, use EMAIL_FROM=Subloom <onboarding@resend.dev>.
# Resend's test sender can deliver to your Resend account email; other real recipients need a verified domain.
# Supabase Auth uses separate SMTP settings: smtp.resend.com, port 465,
# username resend, password = the existing Resend API key, sender onboarding@resend.dev.
# INBOUND_DOMAIN=receipts.your-verified-domain.com
# APP_LINK_BASE=subloom://
# CRON_SECRET=<32-byte-random-secret>
# GOOGLE_VISION_API_KEY=<optional, restricted to Vision API>
# EXPO_ACCESS_TOKEN=<optional Expo enhanced push security>
# Stripe Pro billing (server-only; start with a separate Stripe sandbox):
# STRIPE_SECRET_KEY=<restricted Stripe key with the permissions in PRO_BILLING.md>
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_... (EUR 2.99/month)
# STRIPE_PRICE_YEARLY=price_... (EUR 24/year)
# PRO_RETURN_URL=https://your-app.example/pro
# PRO_LICENSE_PRIVATE_JWK=<JSON from generated server.env; never EXPO_PUBLIC_*>
# EMAIL_PREFERENCES_SECRET=<32-byte-random-secret for signed digest opt-out links>

# Optional mailbox discovery (server-only):
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# MAILBOX_ENCRYPTION_KEY=<32-byte base64 key; preserve the existing key on upgrades>
# MAILBOX_APP_URL=https://your-app.example/mailboxes
# Google/Apple Auth provider credentials are configured in Supabase Auth,
# not in the app bundle. APNs/FCM credentials are configured in EAS.
# Direct bank connections are not implemented in the focused tracker release.
# They require an approved European bank-data provider and a separate integration.
