{
  "name": "subloom",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --web --localhost --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:backend": "deno test --allow-env --allow-net --config supabase/functions/deno.json supabase/functions/tests",
    "check:backend": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "format": "prettier --write src tests docs *.ts *.json",
    "test:live": "node scripts/live-smoke.mjs",
    "deploy:supabase": "node scripts/deploy-supabase.mjs",
    "configure:scheduler": "node scripts/configure-scheduler.mjs",
    "eas": "node scripts/eas.mjs",
    "test:macos": "node scripts/test-macos-server.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "open:macos": "open build/Subloom.app"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "^5.0.3",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
